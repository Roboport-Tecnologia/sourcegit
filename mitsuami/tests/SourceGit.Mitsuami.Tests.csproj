<Project Sdk="Microsoft.NET.Sdk">
  <!-- The port's views and git paths, on mitsuami's headless backend with real git and the
       real editor. No window opens. `codeview/test.sh` runs it, on a library built with
       `test-host`. It runs itself, as a UI needs its one thread. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SourceGit.Mitsuami.Tests</AssemblyName>
    <RootNamespace>SourceGit.Tests</RootNamespace>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SourceGit.Mitsuami.csproj" />
  </ItemGroup>
</Project>
