<Project Sdk="Microsoft.NET.Sdk">
  <!-- SourceGit on mitsuami: upstream's models, view models and git
       commands, compiled where they are; our views and app here. -->
  <PropertyGroup>
    <!-- As upstream's: no console window on Windows. git still reads the
         askpass's answer through the pipe it gives it. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SourceGit</AssemblyName>
    <RootNamespace>SourceGit</RootNamespace>
    <Version>$([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)/../VERSION").Trim())</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Upstream's, which the about window shows. -->
    <Product>SourceGit</Product>
    <Description>OpenSource GIT client</Description>
    <Company>sourcegit-scm</Company>
    <Copyright>Copyright © $([System.DateTime]::Now.Year) sourcegit-scm.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../src/Models/**/*.cs" Exclude="../src/Models/TextMateHelper.cs" />
    <Compile Include="../src/ViewModels/**/*.cs" />
    <Compile Include="../src/Commands/**/*.cs" />
    <Compile Include="../src/AI/**/*.cs" />
    <Compile Include="../src/Native/**/*.cs" />
    <Compile Include="../src/App.JsonCodeGen.cs" />
    <Compile Include="../src/App.Extensions.cs" />
    <Compile Include="**/*.cs" Exclude="bin/**;obj/**;codeview/**;tests/**" />
    <InternalsVisibleTo Include="SourceGit.Mitsuami.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Upstream's strings and images, embedded as Avalonia embeds them and
         named by their paths (EmbeddedFiles). -->
    <EmbeddedResource Include="../src/Resources/Locales/*.axaml" LogicalName="Locales/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../src/Resources/Icons.axaml" LogicalName="Icons.axaml" />
    <EmbeddedResource Include="../src/App.ico" LogicalName="App.ico" />
    <EmbeddedResource Include="../src/Resources/Images/**/*" LogicalName="Resources/Images/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The code view's editor config, plugins but not their tests: bemtvi
         reads it from a directory. -->
    <None Include="codeview/editor/**/*" Exclude="codeview/editor/**/test/**" Link="codeview-editor/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- As upstream's: the app, the runtime and its libraries in one
       executable. DisableAOT=true publishes them as files. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(DisableAOT)' != 'true'">
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>link</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- Upstream's: what its view models reach by reflection stays. -->
    <TrimmerRootAssembly Include="SourceGit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" Version="2.9.0-beta.1" />
    <PackageReference Include="BitMiracle.LibTiff.NET" Version="2.4.660" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="OpenAI" Version="2.10.0" />
    <PackageReference Include="Pfim" Version="0.11.4" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <ProjectReference Include="../../mitsuamia/src/Mitsuamia/Mitsuamia.csproj" />
  </ItemGroup>
  <!-- What mitsuamia's package will bring in on its own (buildTransitive). -->
  <Import Project="../../mitsuamia/src/Mitsuamia/buildTransitive/Mitsuamia.targets" />
</Project>
